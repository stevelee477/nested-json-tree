{
  "name": "nested-json-tree",
  "displayName": "Nested JSON Tree",
  "description": "%extension.description%",
  "version": "0.7.0",
  "publisher": "local-dev",
  "icon": "assets/icon.png",
  "author": {
    "name": "stevelee477",
    "email": "hi.whoareyou12@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/stevelee477/nested-json-tree.git"
  },
  "homepage": "https://github.com/stevelee477/nested-json-tree#readme",
  "bugs": {
    "url": "https://github.com/stevelee477/nested-json-tree/issues"
  },
  "galleryBanner": {
    "color": "#15192D",
    "theme": "dark"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Data Science",
    "Other"
  ],
  "keywords": [
    "json",
    "jsonl",
    "tree",
    "escaped json",
    "nested json"
  ],
  "activationEvents": [
    "onCommand:nestedJsonTree.openDocument",
    "onCommand:nestedJsonTree.openCurrentLine",
    "onCommand:nestedJsonTree.openSelection",
    "onCommand:nestedJsonTree.openClipboard"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "configuration": {
      "title": "Nested JSON Tree",
      "properties": {
        "nestedJsonTree.autoExpandMaxNodes": {
          "type": "integer",
          "default": 200,
          "minimum": 0,
          "maximum": 10000,
          "markdownDescription": "%config.autoExpandMaxNodes%"
        },
        "nestedJsonTree.maxValueNodes": {
          "type": "integer",
          "default": 500000,
          "minimum": 10000,
          "maximum": 5000000,
          "markdownDescription": "%config.maxValueNodes%"
        }
      }
    },
    "commands": [
      {
        "command": "nestedJsonTree.openDocument",
        "title": "%command.openDocument.title%",
        "category": "Nested JSON Tree",
        "icon": "$(json)"
      },
      {
        "command": "nestedJsonTree.openCurrentLine",
        "title": "%command.openCurrentLine.title%",
        "category": "Nested JSON Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "nestedJsonTree.openSelection",
        "title": "%command.openSelection.title%",
        "category": "Nested JSON Tree",
        "icon": "$(selection)"
      },
      {
        "command": "nestedJsonTree.openClipboard",
        "title": "%command.openClipboard.title%",
        "category": "Nested JSON Tree",
        "icon": "$(clippy)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "nestedJsonTree.openDocument",
          "when": "(editorLangId == json || editorLangId == jsonc) && resourceExtname != .jsonl && resourceExtname != .ndjson",
          "group": "navigation@20"
        },
        {
          "command": "nestedJsonTree.openCurrentLine",
          "when": "resourceExtname == .jsonl || resourceExtname == .ndjson",
          "group": "navigation@20"
        }
      ],
      "editor/context": [
        {
          "command": "nestedJsonTree.openSelection",
          "when": "editorHasSelection",
          "group": "navigation@89"
        },
        {
          "command": "nestedJsonTree.openDocument",
          "when": "editorTextFocus && (editorLangId == json || editorLangId == jsonc || resourceExtname == .json || resourceExtname == .jsonc || resourceExtname == .jsonl || resourceExtname == .ndjson)",
          "group": "navigation@90"
        },
        {
          "command": "nestedJsonTree.openCurrentLine",
          "when": "editorTextFocus && (editorLangId == json || editorLangId == jsonc || resourceExtname == .json || resourceExtname == .jsonc || resourceExtname == .jsonl || resourceExtname == .ndjson)",
          "group": "navigation@91"
        }
      ],
      "commandPalette": [
        {
          "command": "nestedJsonTree.openDocument"
        },
        {
          "command": "nestedJsonTree.openCurrentLine"
        },
        {
          "command": "nestedJsonTree.openSelection"
        },
        {
          "command": "nestedJsonTree.openClipboard"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p ./ --noEmit",
    "lint": "eslint .",
    "test": "npm run compile && node --test out/test/*.test.js",
    "test:integration": "npm run compile && node out/integration/runTest.js",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "~20.9.0",
    "@types/vscode": "~1.90.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
